# 复制为 .env 后按环境填写：cp .env.example .env
# 下列带「必填」的项在 config.Settings 中无默认值，缺一不可。

# 必填
ENV=dev
PG_HOST=
PG_PORT=5432
PG_USER=app_iam
PG_DBNAME=macro_report
PG_REGION=ap-east-1
PG_SSLMODE=require
# 本地 DB 代理示例：PG_HOST=127.0.0.1 PG_PORT=15432 PG_SSLMODE=disable PG_PASSWORD=x
PG_PASSWORD=

# FRED Lambda 采集
FRED_API_KEY=
FRED_S3_BUCKET=macro-report-dev-data

# 可选
PORT=8000
INTERNAL_PORT=8080
LOG_LEVEL=INFO

# 管理端手动触发 ECS jobs（本地一般可不填）
ECS_CLUSTER_NAME=
ECS_JOBS_TASK_DEFINITION=
ECS_JOB_SUBNET_IDS=
ECS_JOB_SECURITY_GROUP_IDS=
SCRIPT_LEASE_TABLE=
